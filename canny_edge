import cv2
import numpy as np

def canny_edge_detection(image_path):
    """Mendeteksi tepi menggunakan metode Canny Edge Detection"""
    img = cv2.imread(image_path, cv2.IMREAD_GRAYSCALE)
    if img is None:
        print(f"Error: Gambar tidak ditemukan di {image_path}")
        return None
    img_blur = cv2.GaussianBlur(img, (5, 5), 0)
    edges = cv2.Canny(img_blur, 50, 150)
    cv2.imshow("Canny Edge Detection", edges)
    cv2.waitKey(0)
    cv2.destroyAllWindows()
    result_path = "canny_result.jpg"
    cv2.imwrite(result_path, edges)
    print(f"Hasil Canny Edge Detection disimpan sebagai {result_path}")
    return result_path

# Contoh penggunaan
canny_edge_detection("dataset/1000195092_0005-0_jpeg.rf.00e151ef8c1d507805f6382d515299b8.jpg")
